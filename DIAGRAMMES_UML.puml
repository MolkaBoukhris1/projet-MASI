node "Poste Utilisateur" {
    component "JavaFX Application" {
        [DrawingApplication]
        [MainController]
        [DrawingManager]
        [ShapeFactory]
        [CommandManager]
        [Logger]
    }
    
    database "SQLite" {
        [drawing_app.db]
    }
    
